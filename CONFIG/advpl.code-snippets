            "#INCLUDE \"PROTHEUS.CH\"",
            "#INCLUDE \"TOPCONN.CH\"",
            "",
            "/*/{Protheus.doc} ${1:NOMEFUNC}",
            "${2:Descricao do programa}",
            "@type User Function",
            "@version 12.1.33",
            "@author ${3:Autor}",
            "@since ${CURRENT_DATE}/${CURRENT_MONTH}/${CURRENT_YEAR}",
            "/*/",
            "User Function ${1:NOMEFUNC}()",
            "    Local aArea := GetArea()",
            "    $0",
            "    RestArea(aArea)",
            "Return"
        ],
        "description": "User Function completa com GetArea/RestArea e Protheus.doc"
    },
