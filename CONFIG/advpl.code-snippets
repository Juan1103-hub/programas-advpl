    "aScan protegido": {
        "prefix": "ascan",
        "body": [
            "nPos := aScan(${1:aLista}, {|x| x[${2:1}] == ${3:cChave}})",
            "If nPos > 0",
            "    $0",
            "EndIf"
        ],
        "description": "aScan com validacao de posicao"
    },
    "Filtro de Grid": {
        "prefix": "filtro",
        "body": [
            "Local cBusca := AllTrim(Upper(${1:cFiltro}))",
            "Local nI",
            "",
            "${2:aDados} := {}",
            "",
            "If Empty(cBusca)",
            "    ${2:aDados} := aClone(${3:aDadosOrig})",
            "Else",
            "    For nI := 1 To Len(${3:aDadosOrig})",
            "        If (cBusca \\$ Upper(${3:aDadosOrig}[nI][${4:1}])) .Or. ;",
            "           (cBusca \\$ Upper(${3:aDadosOrig}[nI][${5:2}]))",
            "            aAdd(${2:aDados}, ${3:aDadosOrig}[nI])",
            "        EndIf",
            "    Next nI",
            "    If Len(${2:aDados}) == 0",
            "        ${2:aDados} := aClone(${3:aDadosOrig})",
            "        MsgInfo(\"Nenhum registro encontrado.\", \"Filtro\")",
            "    EndIf",
            "EndIf"
        ],
        "description": "Logica de filtro para grid de arrays"
    }
}